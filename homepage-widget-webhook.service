[Unit]
Description=Homepage customapi widget webhook server
After=network.target

[Service]
Type=simple
User=jeliozver
Group=jeliozver
WorkingDirectory=/home/jeliozver/homepage-custom-widget-webhook
ExecStart=/home/jeliozver/.bun/bin/bun run serve
KillMode=control-group
Restart=on-failure
Environment=NODE_ENV=production
Environment=PATH=/home/jeliozver/.bun/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=multi-user.target
