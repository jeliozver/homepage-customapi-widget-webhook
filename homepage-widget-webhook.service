[Unit]
Description=Homepage customapi widget webhook server
After=network.target

[Service]
Type=simple
User=jeliozver
Group=jeliozver
WorkingDirectory=/home/jeliozver/homepage-custom-widget-webhook
ExecStart=/usr/local/bin/npm run serve
KillMode=control-group
Restart=on-failure
Environment=NODE_ENV=production
Environment=PATH=/usr/bin:/usr/local/bin

[Install]
WantedBy=multi-user.target
